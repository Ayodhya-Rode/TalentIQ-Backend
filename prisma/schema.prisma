// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  ORG_ADMIN
  RECRUITER
  INTERVIEWER
  SUPER_ADMIN
  SUPPORT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  role      Role
  isVerified Boolean  @default(false)
  deactivatedByAdmin Boolean @default(false)  
  otp        String?
  otpExpiry  DateTime?
  refreshToken String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  organization Organization?
  candidateProfile CandidateProfile?
  isActive Boolean @default(true)
  inviteToken  String?  @unique   
  inviteExpiry DateTime?              
  memberOrgId  Int?                      
  memberOrg    Organization? @relation("OrgMembers", fields: [memberOrgId], references: [id]) 
  jobs Job[] @relation("RecruiterJobs")
  applications Application[] @relation("CandidateApplications")
  domains          Domain[]            @default([])
  availabilitySlots AvailabilitySlot[]
  candidateBookings InterviewBooking[] @relation("CandidateBookings")
  empBookings       InterviewBooking[] @relation("EmpBookings")
  cancellations BookingCancellation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  industry  String
  logo      String?
  status    OrgStatus @default(PENDING)
  adminId   Int       @unique
  admin     User      @relation(fields: [adminId], references: [id])
  members   User[]    @relation("OrgMembers")
  jobs Job[]
  interviewBookings InterviewBooking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CandidateProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String?
  phone     String?
  skills    String[] @default([])
  bio       String?
  resumeUrl String?
  profileImage String?
  portfolioUrl  String?
  githubUrl     String?
  linkedinUrl   String?
  education    Education[]
  certificates Certificate[]
  location String?
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?

  createdAt DateTime @default(now())
}

model Certificate {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  name          String
  issuer        String
  issueDate     DateTime?
  credentialUrl String?

  createdAt DateTime @default(now())
}

model Project {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  name        String
  description String?
  techStack   String[] @default([])
  link        String?

  createdAt DateTime @default(now())
}

enum JobStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  department  String?
  employmentType EmploymentType
  location    String?
  isRemote    Boolean   @default(false)
  status      JobStatus @default(PENDING_APPROVAL)

  previousSnapshot Json?     // holds old field values while an edit awaits re-approval; cleared on approve

  rejectionReason String?    // set by Org Admin on reject, shown to Recruiter

  recruiterId Int
  recruiter   User         @relation("RecruiterJobs", fields: [recruiterId], references: [id])

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  applications Application[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
}

model Application {
  id         Int               @id @default(autoincrement())
  status     ApplicationStatus @default(APPLIED)
  coverNote  String?

  candidateId Int
  candidate   User    @relation("CandidateApplications", fields: [candidateId], references: [id])

  jobId Int
  job   Job    @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobId])
}

enum Domain {
  FULL_STACK
  DATA_SCIENCE
  DEVOPS
  JAVA_DEVELOPER
  AI_ENGINEER
  FRONTEND
  BACKEND
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AvailabilitySlot {
  id        Int       @id @default(autoincrement())
  dayOfWeek DayOfWeek
  startTime String    // "10:00" 24hr format
  endTime   String    // "13:00"

  empId Int
  emp   User @relation(fields: [empId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING_PAYMENT
  ASSIGNED
  NEEDS_ATTENTION
  COMPLETED
  CANCELLED
}

model InterviewBooking {
  id       Int    @id @default(autoincrement())
  domain   Domain
  status   BookingStatus @default(PENDING_PAYMENT)

  scheduledDate DateTime

  candidateId Int
  candidate   User @relation("CandidateBookings", fields: [candidateId], references: [id])

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  assignedEmpId Int?
  assignedEmp   User? @relation("EmpBookings", fields: [assignedEmpId], references: [id])

  reassignCount Int @default(0)
  @@unique([assignedEmpId, scheduledDate])
  cancellations BookingCancellation[]
  videoRoomUrl String?
  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BookingCancellation {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   InterviewBooking @relation(fields: [bookingId], references: [id])
  empId     Int
  emp       User @relation(fields: [empId], references: [id])
  createdAt DateTime @default(now())
}