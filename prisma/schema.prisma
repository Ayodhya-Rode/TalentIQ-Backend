// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  ORG_ADMIN
  RECRUITER
  INTERVIEWER
  SUPER_ADMIN
  SUPPORT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  role      Role
  isVerified Boolean  @default(false)
  deactivatedByAdmin Boolean @default(false)  
  otp        String?
  otpExpiry  DateTime?
  refreshToken String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  organization Organization?
  candidateProfile CandidateProfile?
  isActive Boolean @default(true)
  inviteToken  String?  @unique   
  inviteExpiry DateTime?              
  memberOrgId  Int?                      
  memberOrg    Organization? @relation("OrgMembers", fields: [memberOrgId], references: [id]) 
  jobs Job[] @relation("RecruiterJobs")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  industry  String
  logo      String?
  status    OrgStatus @default(PENDING)
  adminId   Int       @unique
  admin     User      @relation(fields: [adminId], references: [id])
  members   User[]    @relation("OrgMembers")
  jobs Job[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CandidateProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String?
  phone     String?
  skills    String[] @default([])
  bio       String?
  resumeUrl String?
  profileImage String?
  portfolioUrl  String?
  githubUrl     String?
  linkedinUrl   String?
  education    Education[]
  certificates Certificate[]
  location String?
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?

  createdAt DateTime @default(now())
}

model Certificate {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  name          String
  issuer        String
  issueDate     DateTime?
  credentialUrl String?

  createdAt DateTime @default(now())
}

model Project {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  name        String
  description String?
  techStack   String[] @default([])
  link        String?

  createdAt DateTime @default(now())
}

enum JobStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  department  String?
  employmentType EmploymentType
  location    String?
  isRemote    Boolean   @default(false)
  status      JobStatus @default(PENDING_APPROVAL)

  previousSnapshot Json?     // holds old field values while an edit awaits re-approval; cleared on approve

  rejectionReason String?    // set by Org Admin on reject, shown to Recruiter

  recruiterId Int
  recruiter   User         @relation("RecruiterJobs", fields: [recruiterId], references: [id])

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}